[
  {
    "name": "CyoloActivityConnector",
    "apiVersion": "2023-04-01-preview",
    "type": "Microsoft.SecurityInsights/dataConnectors",
    "location": "{{location}}",
    "kind": "RestApiPoller",
    "properties": {
      "connectorDefinitionName": "CyoloActivityCCFDefinition",
      "dcrConfig": {
        "dataCollectionEndpoint": "{{dataCollectionEndpoint}}",
        "dataCollectionRuleImmutableId": "{{dataCollectionRuleImmutableId}}",
        "streamName": "Custom-CyoloActivityLog"
      },
      "dataType": "CyoloActivity_CL",
      "auth": {
        "type": "Basic",
        "userName": "[[parameters('username')]",
        "password": "[[parameters('password')]"
      },
      "request": {
        "apiEndpoint": "[[concat(parameters('apiUrl'), '/v1/activity_log')]",
        "rateLimitQPS": 10,
        "queryWindowInMin": 5,
        "httpMethod": "Get",
        "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
        "startTimeAttributeName": "from",
        "endTimeAttributeName": "to",
        "retryCount": 3,
        "timeoutInSeconds": 60,
        "headers": {
          "Accept": "application/json"
        },
        "queryParameters": {
          "_sort": "+timestamp",
          "_count": 10000
        }
      },
      "paging": {
        "pagingType": "Offset",
        "offsetParaName": "offset",
        "pageSizeParaName": "limit",
        "pageSize": 1000
      },
      "response": {
        "eventsJsonPaths": [
          "$.data[*]"
        ]
      },
      "isActive": true
    }
  }
]
